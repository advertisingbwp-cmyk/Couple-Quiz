# Couple & Friendship Quiz Environment Configuration

# Durable Cloud Storage (Upstash Redis)
# REQUIRED for production deployments (Vercel, AWS Lambda, serverless).
# Local JSON file storage is enabled automatically for local dev and testing only.
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Trusted Proxy Configuration (Anti-Spoofing Client IP Extraction)
# On Vercel: VERCEL=1 is set automatically by the platform; x-vercel-forwarded-for is used.
# On Cloudflare: Set QUIZ_TRUSTED_PROXY=cloudflare ONLY when origin traffic is restricted
# to Cloudflare IPs (e.g. Authenticated Origin Pulls / Cloudflare Tunnel) so cf-connecting-ip
# cannot be spoofed by reaching the origin directly.
# QUIZ_TRUSTED_PROXY=cloudflare

# Optional Real Redis Integration Test Configuration (Never use production credentials)
# QUIZ_REDIS_INTEGRATION=1
# QUIZ_TEST_REDIS_REST_URL=https://your-disposable-test-db.upstash.io
# QUIZ_TEST_REDIS_REST_TOKEN=your_disposable_test_token_here

