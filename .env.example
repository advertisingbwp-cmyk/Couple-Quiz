# =============================================================================
# Couple & Friendship Quiz Environment Configuration
# =============================================================================

# Primary Production Storage (Supabase PostgreSQL)
# REQUIRED for production and serverless environments (Vercel, AWS Lambda).
# Local JSON file storage is automatically enabled as fallback for local dev.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# IMPORTANT SECURITY NOTE:
# Never prefix SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
# Service role credentials must strictly remain on the server.

# Trusted Proxy Configuration (Anti-Spoofing Client IP Extraction)
# On Vercel: VERCEL=1 is set automatically by the platform; x-vercel-forwarded-for is used.
# On Cloudflare: Set QUIZ_TRUSTED_PROXY=cloudflare ONLY when origin traffic is restricted
# to Cloudflare IPs (e.g. Authenticated Origin Pulls / Cloudflare Tunnel) so cf-connecting-ip
# cannot be spoofed by reaching the origin directly.
# QUIZ_TRUSTED_PROXY=cloudflare

# Optional Real Supabase Integration Test Configuration (Disposable Test Project ONLY)
# Never point integration tests at production data!
# QUIZ_SUPABASE_INTEGRATION=1
# QUIZ_TEST_SUPABASE_URL=https://your-disposable-test-project.supabase.co
# QUIZ_TEST_SUPABASE_SERVICE_ROLE_KEY=your_disposable_test_service_role_key
# Optional: Publishable/anon key used to verify least-privilege permission denial
# SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here


